{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketcoder.org/schemas/release-channel-pointer-v1.schema.json",
  "$comment": "The exact pointer bytes are accompanied by a detached Ed25519 signature. Consumers verify that signature with an embedded trusted key before accepting any field.",
  "title": "PocketCoder release channel pointer",
  "description": "Mutable, signed discovery pointer from one release channel to an immutable content-addressed manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "sequence",
    "promotedAt",
    "manifest",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "type": "string",
      "enum": [
        "stable",
        "beta",
        "nightly"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonically increasing within this channel. Consumers persist and reject lower values."
    },
    "promotedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "downloadBytes",
        "signature"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Release identity and expected SHA-256 of the immutable manifest bytes."
        },
        "downloadBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576,
          "description": "Exact immutable manifest byte length, enforced before parsing."
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "keyId",
            "url"
          ],
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "keyId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://[^/]+/"
            }
          }
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signatureDescriptor",
      "description": "Detached signature over the exact channel pointer bytes."
    },
    "extensions": {
      "type": "object",
      "description": "Optional, ignorable channel metadata."
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeVersion": {
      "type": "integer",
      "minimum": 0
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+/"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        }
      }
    },
    "signatureDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "url"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  }
}
