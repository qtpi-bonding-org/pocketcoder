{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketcoder.org/schemas/release-revocation-v1.schema.json",
  "title": "PocketCoder release revocations",
  "description": "Signed mutable list at the fixed /v1/revocations/releases.json path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "publishedAt",
    "revokedReleases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sequence": {
      "$ref": "#/$defs/positiveVersion"
    },
    "publishedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "revokedReleases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/revocation"
      },
      "propertyNames": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "$defs": {
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasonCode",
        "summary",
        "revokedAt"
      ],
      "properties": {
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "revokedAt": {
          "$ref": "#/$defs/utcTimestamp"
        }
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeVersion": {
      "type": "integer",
      "minimum": 0
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+/"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        }
      }
    }
  }
}
