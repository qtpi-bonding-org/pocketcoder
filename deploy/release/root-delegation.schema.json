{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketcoder.org/schemas/root-delegation-v1.schema.json",
  "title": "PocketCoder root signing delegation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sequence",
    "issuedAt",
    "rootKeyId",
    "roles",
    "revokedKeyIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sequence": {
      "$ref": "#/$defs/positiveVersion"
    },
    "issuedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "rootKeyId": {
      "$ref": "#/$defs/identifier"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "channel",
        "metadata",
        "revocation"
      ],
      "properties": {
        "release": {
          "$ref": "#/$defs/delegatedKeys"
        },
        "channel": {
          "$ref": "#/$defs/delegatedKeys"
        },
        "metadata": {
          "$ref": "#/$defs/delegatedKeys"
        },
        "revocation": {
          "$ref": "#/$defs/delegatedKeys"
        }
      }
    },
    "revokedKeyIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "$defs": {
    "delegatedKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/delegatedKey"
      }
    },
    "delegatedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "algorithm",
        "publicKey",
        "validFrom",
        "validUntil"
      ],
      "properties": {
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "algorithm": {
          "const": "ed25519"
        },
        "publicKey": {
          "$ref": "#/$defs/base64"
        },
        "validFrom": {
          "$ref": "#/$defs/utcTimestamp"
        },
        "validUntil": {
          "oneOf": [
            {
              "$ref": "#/$defs/utcTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeVersion": {
      "type": "integer",
      "minimum": 0
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+/"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        }
      }
    },
    "signatureDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "url"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  }
}
