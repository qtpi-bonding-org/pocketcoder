{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketcoder.org/schemas/signature-envelope-v1.schema.json",
  "title": "PocketCoder detached signature envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "role",
    "keyId",
    "payloadSha256",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "algorithm": {
      "const": "ed25519"
    },
    "role": {
      "enum": [
        "root",
        "release",
        "channel",
        "metadata",
        "revocation"
      ]
    },
    "keyId": {
      "$ref": "#/$defs/identifier"
    },
    "payloadSha256": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "$ref": "#/$defs/base64",
      "description": "Base64 Ed25519 signature over the exact payload bytes."
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeVersion": {
      "type": "integer",
      "minimum": 0
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+/"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        }
      }
    },
    "signatureDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "url"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "$ref": "#/$defs/identifier"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    }
  }
}
