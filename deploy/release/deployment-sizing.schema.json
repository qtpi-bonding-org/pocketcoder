{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketcoder.org/schemas/deployment-sizing-v1.schema.json",
  "title": "PocketCoder deployment sizing policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "memorySizing",
    "localModelSizing"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "memorySizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumDeploymentBytes",
        "recommendedDeploymentBytes",
        "measuredIdle"
      ],
      "properties": {
        "minimumDeploymentBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Smallest supported deployment before adding local model and context bytes. Consumers compare exact bytes and round up only when selecting a provider plan."
        },
        "recommendedDeploymentBytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Recommended deployment memory for operational headroom. It must be greater than or equal to minimumDeploymentBytes; consumers enforce this cross-field invariant."
        },
        "measuredIdle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sampleCount",
            "statistic",
            "platform",
            "environment",
            "coreServices",
            "harnesses",
            "optionalServices",
            "hostServiceEstimates",
            "transientProcessPeaks",
            "dockerRuntime"
          ],
          "properties": {
            "sampleCount": {
              "type": "integer",
              "minimum": 1
            },
            "statistic": {
              "const": "maximum"
            },
            "platform": {
              "$ref": "#/$defs/platform"
            },
            "environment": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runtime",
                "runtimeMemoryLimitBytes"
              ],
              "properties": {
                "runtime": {
                  "type": "string",
                  "minLength": 1
                },
                "runtimeMemoryLimitBytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "coreServices": {
              "$ref": "#/$defs/idleMemoryMap"
            },
            "harnesses": {
              "$ref": "#/$defs/idleMemoryMap"
            },
            "optionalServices": {
              "$ref": "#/$defs/idleMemoryMap"
            },
            "hostServiceEstimates": {
              "$ref": "#/$defs/idleMemoryMap",
              "description": "Container-measured approximations for services that run natively on supported VPS deployments."
            },
            "transientProcessPeaks": {
              "$ref": "#/$defs/idleMemoryMap",
              "description": "Maximum resident bytes for one-shot processes. These values are not part of steady-state idle memory."
            },
            "dockerRuntime": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sampleCount",
                "activeContainerCount",
                "processes",
                "containerShimMaximumBytes"
              ],
              "properties": {
                "sampleCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "activeContainerCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "processes": {
                  "$ref": "#/$defs/idleMemoryMap"
                },
                "containerShimMaximumBytes": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Largest observed resident set for one containerd shim; consumers multiply it by the selected running-container count."
                }
              }
            }
          }
        }
      }
    },
    "localModelSizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpuSystemMemoryMinimumBytes",
        "cpuModelMultiplier",
        "cpuContextMultiplier",
        "gpuVramModelMultiplier",
        "gpuVramContextMultiplier"
      ],
      "properties": {
        "gpuSystemMemoryMinimumBytes": {
          "type": "integer",
          "minimum": 1
        },
        "cpuModelMultiplier": {
          "const": 1
        },
        "cpuContextMultiplier": {
          "const": 1
        },
        "gpuVramModelMultiplier": {
          "const": 1
        },
        "gpuVramContextMultiplier": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "idleMemoryMap": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveVersion": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeVersion": {
      "type": "integer",
      "minimum": 0
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+/"
    },
    "base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        }
      }
    }
  }
}
