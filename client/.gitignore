# Flutter/Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
# Runtime generated sources for the public package are tracked so it is
# consumable from a clean checkout. Other generated sources remain local.
**/*.freezed.dart
**/*.g.dart
!packages/pocketcoder_flutter/lib/**/*.freezed.dart
!packages/pocketcoder_flutter/lib/**/*.g.dart
packages/**/pubspec.lock
.flutter-plugins-dependencies

# Melos
.melos_plugins_config
melos_*.iml

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Mobile specific
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/App.framework
ios/Flutter/App.podspec
ios/Flutter/App.framework
android/key.properties
android/local.properties
apps/pocketcoder/android/app/google-services.json
apps/pocketcoder/ios/Runner/GoogleService-Info.plist
macos/Podfile.lock

# Symbol files
**/*.pdb
**/*.dll
**/*.exe
