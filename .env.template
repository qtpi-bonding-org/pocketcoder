# --- PocketBase Credentials ---
POCKETBASE_SUPERUSER_EMAIL=superuser@pocketcoder.local
POCKETBASE_SUPERUSER_PASSWORD=pocketcoder_superuser
POCKETBASE_ADMIN_EMAIL=human@pocketcoder.local
POCKETBASE_ADMIN_PASSWORD=pocketcoder_human

# --- AI Agent Credentials ---
AGENT_EMAIL=poco@pocketcoder.local
AGENT_PASSWORD=pocketcoder_poco

# --- Goose agent (c2) — required for `docker compose --profile agent up` ---
# Shared secret for the c1<->c2 authenticated WebSocket. goose v1.43 refuses to
# serve without it, and c1 uses the SAME value to authenticate (?token=).
# Generate one: `openssl rand -hex 32`. Never expose this to Flutter/browsers.
GOOSE_SERVER__SECRET_KEY=change-me-to-a-long-random-secret
# c1 dials goose directly (no relay). Override only for non-default topologies.
GOOSE_ACP_URL=ws://goose:3000/acp
# Provider used by goose (only `anthropic` is validated on the pinned image).
GOOSE_PROVIDER=anthropic
GOOSE_MODEL=MiniMax-M2.5
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_OR_MINIMAX_KEY_HERE
ANTHROPIC_HOST=https://api.minimax.io/anthropic

# --- Caddy Reverse Proxy ---
# Required when using --profile caddy
# Use sslip.io for automatic SSL: replace dots with dashes in your IP
# Example: 194.163.45.3 → 194-163-45-3.sslip.io
CADDY_DOMAIN=localhost

# --- Tailscale Remote Access ---
# Required when using --profile tailscale
# Get an auth key from: https://login.tailscale.com/admin/settings/keys
# Leave blank for interactive login (check docker logs for URL)
TS_AUTHKEY=
# "private" = Tailnet devices only (recommended), "funnel" = public URL
TAILSCALE_MODE=private
# Hostname shown in Tailscale admin console
TS_HOSTNAME=pocketcoder
